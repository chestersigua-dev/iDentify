# ==============================================================================
# iDentify: DepEd Multi-Tenant School Management & Attendance SaaS Environment
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# Tenancy & Base Domains
ROOT_DOMAIN=localhost:3000
API_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=identify_user
DB_PASSWORD=identify_secure_pass_2026
DB_NAME=identify_saas_db
DATABASE_URL=postgresql://identify_user:identify_secure_pass_2026@localhost:5432/identify_saas_db?schema=public

# Redis Configuration (BullMQ & Scan Debouncing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Keys (Auto-generated by launcher if missing)
JWT_SECRET=replace_with_32_byte_hex_generated_secret_key_1
JWT_REFRESH_SECRET=replace_with_32_byte_hex_generated_secret_key_2
HMAC_AUDIT_SALT=replace_with_32_byte_hex_generated_secret_key_3
ENCRYPTION_KEY=replace_with_32_byte_hex_generated_secret_key_4

# SMS Gateway Configuration
SMS_PROVIDER=EASYSMS# Options: EASYSMS, SEMAPHORE, PHILSMS, MOCK
EASYSMS_API_KEY=your_easysms_api_key_from_my_easysendsms_app
EASYSMS_SENDER_NAME=iDentify
SEMAPHORE_API_KEY=mock_semaphore_api_key_deped
SEMAPHORE_SENDER_NAME=iDentify
PHILSMS_API_TOKEN=mock_philsms_api_token_deped
PHILSMS_SENDER_ID=iDentify

# DepEd LIS Direct API Integration (OAuth2 / API Key)
DEPED_LIS_API_MODE=MOCK# Options: DIRECT, MOCK
DEPED_LIS_ENDPOINT=https://lis.deped.gov.ph/api/v2
DEPED_LIS_CLIENT_ID=deped_partner_client_id
DEPED_LIS_CLIENT_SECRET=deped_partner_client_secret

# Object Storage (S3 / R2 / Local MinIO)
STORAGE_DRIVER=LOCAL# Options: LOCAL, S3, R2, MINIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=identify-school-assets
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Default Super Admin Seed
SUPER_ADMIN_EMAIL=superadmin@deped.gov.ph
SUPER_ADMIN_PASSWORD=SuperAdmin123!
